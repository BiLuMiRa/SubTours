<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="SubToursPU" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <mapping-file>META-INF/orm.xml</mapping-file>
        <class>com.subtours.model.AmostraCientifica</class>
        <class>com.subtours.model.AutorizacaoAmbiental</class>
        <class>com.subtours.model.ColetaCientifica</class>
        <class>com.subtours.model.Equipamento</class>
        <class>com.subtours.model.GuiaEspeleologia</class>
        <class>com.subtours.model.Pesquisador</class>
        <class>com.subtours.model.Pessoa</class>
        <class>com.subtours.model.PlanoSeguranca</class>
        <class>com.subtours.model.Relatorio</class>
        <class>com.subtours.model.Caverna</class>
        <class>com.subtours.model.Participacao</class>
        <class>com.subtours.model.SetorPesquisa</class>
        <class>com.subtours.model.UtilizacaoEquipamento</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver" />
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/subtours" />
            <property name="jakarta.persistence.jdbc.user" value="postgres" />
            <property name="jakarta.persistence.jdbc.password" value="Bianc@rb1421" />
            <!-- Trocar o CREATE para UPDATE quando começar a popular o banco -->
            <property name="hibernate.hbm2ddl.auto" value="update" />
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
        </properties>
    </persistence-unit>

</persistence>